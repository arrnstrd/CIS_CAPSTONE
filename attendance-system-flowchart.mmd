flowchart TD

    START(["Start: Student Arrives at Kiosk Terminal"]) --> SCAN_INPUT["Student Presents QR Badge to Optical or USB HID Scanner"]
    SCAN_INPUT --> CHK_SCAN_READ{"Did Scanner Capture Valid QR String?"}
    
    CHK_SCAN_READ -->|No or Misaligned| ERR_SCAN_FAIL["Scanner Emits Error Tone and Prompts Re-Scan"]
    ERR_SCAN_FAIL --> SCAN_INPUT
    
    CHK_SCAN_READ -->|Yes| API_DISPATCH["Kiosk Transmits Token and Device ID to Backend API"]
    
    API_DISPATCH --> CHK_STUDENT_EXISTS{"Is QR Code Linked to an Active Student?"}
    CHK_STUDENT_EXISTS -->|No or Inactive| ERR_404_STUDENT["Display Error 404: Invalid QR or Student Not Found"]
    ERR_404_STUDENT --> TERM_END_SCAN(["Terminal: Scan Terminated"])
    
    CHK_STUDENT_EXISTS -->|Yes| CHK_ACTIVE_ENROLL{"Does Student Have Active Enrollment in Current School Year?"}
    CHK_ACTIVE_ENROLL -->|No or Unenrolled| ERR_404_ENROLL["Display Error 404: No Active Enrollment Found"]
    ERR_404_ENROLL --> TERM_END_SCAN
    
    CHK_ACTIVE_ENROLL -->|Yes| RES_SCHEDULE["Resolve Academic Schedule for Grade Level and Session"]
    RES_SCHEDULE --> CHK_ACTIVE_SCHED{"Is Current Time Within an Active Schedule?"}
    CHK_ACTIVE_SCHED -->|No| ERR_400_SCHED["Display Error 400: No Active Schedule for Current Time"]
    ERR_400_SCHED --> TERM_END_SCAN
    
    CHK_ACTIVE_SCHED -->|Yes| ATOMIC_LOCK["Initiate Database Transaction and Lock Daily Attendance Record"]
    ATOMIC_LOCK --> CHK_COOLDOWN{"Is Spam Cooldown Timer Active for This Student?"}
    
    CHK_COOLDOWN -->|Yes - Under Cooldown| LOG_EXCESS["Increment Spam Offense Count and Record excess_scan Flag"]
    LOG_EXCESS --> ERR_429_COOLDOWN["Display Error 429: Too Many Scans - Wait for Cooldown"]
    ERR_429_COOLDOWN --> TERM_END_SCAN
    
    CHK_COOLDOWN -->|No - Cooldown Cleared| CHK_COMPLETED_CYCLE{"Has Student Completed Both Time-In and Time-Out Today?"}
    CHK_COMPLETED_CYCLE -->|Yes - Cycle Done| LOG_REJECT_IN["Log duplicate_scan Flag and Reject Additional Entry"]
    LOG_REJECT_IN --> ERR_400_DUP_CYCLE["Display Error 400: Daily Attendance Cycle Completed"]
    ERR_400_DUP_CYCLE --> TERM_END_SCAN
    
    CHK_COMPLETED_CYCLE -->|No - Proceed| CONN_1((A))

    CONN_1 --> EVAL_DIRECTION{"Has Student Already Timed-In Today?"}
    EVAL_DIRECTION -->|No Record Today| TARGET_IN["Target State: TIME-IN"]
    EVAL_DIRECTION -->|Active Time-In Exists| TARGET_OUT["Target State: TIME-OUT"]
    
    TARGET_IN --> CHK_IN_WINDOW{"Is Current Time Within Check-In Window?"}
    CHK_IN_WINDOW -->|No| ERR_IN_WINDOW["Display Error 400: Outside Allowed Check-In Window"]
    ERR_IN_WINDOW --> TERM_END_SCAN
    
    CHK_IN_WINDOW -->|Yes| CHK_LATE{"Is Current Time Past the Late Threshold?"}
    CHK_LATE -->|Yes| MARK_LATE["Status: Late Arrival - Record late_arrival Flag"]
    CHK_LATE -->|No| MARK_ON_TIME["Status: On-Time Arrival - Normal Gate Status"]
    
    MARK_LATE --> CREATE_IN_LOG["Persist Gate AttendanceLog with Type IN"]
    MARK_ON_TIME --> CREATE_IN_LOG
    CREATE_IN_LOG --> LINK_TIME_IN["Update Daily QrAttendance: Set time_in_log_id and Arm Cooldown"]
    
    TARGET_OUT --> CHK_OUT_WINDOW{"Is Current Time Within Dismissal Window?"}
    CHK_OUT_WINDOW -->|No - Early Scan| CHK_DUP_ATTEMPTS{"Has Student Exceeded Max 3 Duplicate Attempts?"}
    
    CHK_DUP_ATTEMPTS -->|No| WARN_EARLY["Record duplicate_scan Flag and Increment Spam Count"]
    WARN_EARLY --> ERR_EARLY_OUT["Display Error 400: Please Wait for Dismissal Window"]
    ERR_EARLY_OUT --> TERM_END_SCAN
    
    CHK_DUP_ATTEMPTS -->|Yes| COOLDOWN_PENALTY["Record excess_scan Flag and Apply Cooldown Penalty"]
    COOLDOWN_PENALTY --> ERR_429_PENALTY["Display Error 429: Too Many Scans - Cooldown Applied"]
    ERR_429_PENALTY --> TERM_END_SCAN
    
    CHK_OUT_WINDOW -->|Yes| CREATE_OUT_LOG["Persist Gate AttendanceLog with Type OUT"]
    CREATE_OUT_LOG --> LINK_TIME_OUT["Update Daily QrAttendance: Set time_out_log_id and Arm Cooldown"]
    
    LINK_TIME_IN --> CONN_2((B))
    LINK_TIME_OUT --> CONN_2

    CONN_2 --> BROADCAST_WS["Broadcast Real-Time Event via Laravel Reverb to Live Kiosk and Dashboards"]
    BROADCAST_WS --> KIOSK_POPUP["Display Green Confirmation Card on Kiosk Terminal with Student Info and Status"]
    
    KIOSK_POPUP --> CHK_GUARDIAN_EMAIL{"Does Student Have a Registered Guardian Email?"}
    CHK_GUARDIAN_EMAIL -->|Yes| QUEUE_MAIL["Create EmailLog and Dispatch SendGateScanNotification Job"]
    CHK_GUARDIAN_EMAIL -->|No| BYPASS_MAIL["Bypass Guardian Email Alert"]
    
    QUEUE_MAIL --> ESTABLISH_BASELINE["Establish Automated Attendance Baseline"]
    BYPASS_MAIL --> ESTABLISH_BASELINE
    
    ESTABLISH_BASELINE --> BASELINE_RULE["Hierarchy Rule: Gate Time-In sets Baseline PRESENT - Missing Scan sets Baseline ABSENT"]
    BASELINE_RULE --> CONN_3((C))

    CONN_3 --> TEACHER_LOGIN["Subject Teacher Accesses Room Attendance Portal"]
    TEACHER_LOGIN --> CHK_TEACHING_ASSIGN{"Does Teacher Have Active Teaching Assignment for Section and Subject?"}
    
    CHK_TEACHING_ASSIGN -->|No| ERR_403_TEACHER["Access Denied: 403 Forbidden"]
    ERR_403_TEACHER --> TERM_END_VERIFY(["Terminal: Action Blocked"])
    
    CHK_TEACHING_ASSIGN -->|Yes| AUTO_EXPIRE_CHECK["Automated Expiry Routine Checks Expired Records"]
    AUTO_EXPIRE_CHECK --> CHK_EXPIRED_GRACE{"Did Any Not in Classroom Record Exceed 60-Minute Grace Period?"}
    
    CHK_EXPIRED_GRACE -->|Yes| AUTO_TRANS_ABSENT["Auto-Transition Status to ABSENT with Resolved By SYSTEM"]
    CHK_EXPIRED_GRACE -->|No| LOAD_ROSTER["Load Section Roster Matrix with Gate Scan and Verification Status"]
    AUTO_TRANS_ABSENT --> LOAD_ROSTER
    
    LOAD_ROSTER --> EVAL_GATE_STATUS{"Did Student Self-Scan at Gate Kiosk Today?"}
    
    EVAL_GATE_STATUS -->|Yes - Gate In Exists| EVAL_PHYSICAL_PRESENCE{"Is Student Physically Sitting in the Subject Classroom?"}
    
    EVAL_PHYSICAL_PRESENCE -->|Yes| TEACHER_MARK_PRES["Teacher Confirms Status: PRESENT or LATE"]
    
    EVAL_PHYSICAL_PRESENCE -->|No - Missing or Cutting| TEACHER_MARK_NIC["Teacher Tags Status: NOT IN CLASSROOM"]
    TEACHER_MARK_NIC --> ARM_GRACE["Initiate 60-Minute Grace Period Countdown Timer"]
    
    ARM_GRACE --> CHK_STUDENT_ARRIVES{"Does Student Arrive Before 60-Minute Grace Period Expires?"}
    CHK_STUDENT_ARRIVES -->|Yes - Teacher Resolved| TEACHER_RESOLVE["Teacher Updates Status to PRESENT or LATE with Remarks"]
    
    CHK_STUDENT_ARRIVES -->|No - Grace Expired| SYS_RESOLVE["System Automatically Converts Status to ABSENT"]
    
    EVAL_GATE_STATUS -->|No - No Gate Scan| EVAL_ROOM_OVERRIDE{"Is Student Physically Present in Classroom Regardless?"}
    
    EVAL_ROOM_OVERRIDE -->|Yes - Manual Override| TEACHER_OVERRIDE["Teacher Marks PRESENT or EXCUSED overriding Gate Baseline"]
    
    EVAL_ROOM_OVERRIDE -->|No - Not in Class| CHK_EXCUSED{"Did Student or Guardian Present Legitimate Excuse Slip?"}
    
    CHK_EXCUSED -->|Yes| TEACHER_MARK_EXCUSED["Teacher Marks Status: EXCUSED with Justification Remarks"]
    CHK_EXCUSED -->|No| CONFIRM_ABSENT["Status Confirmed as ABSENT - Unexcused Absence"]
    
    TEACHER_MARK_PRES --> CONN_4((D))
    TEACHER_RESOLVE --> CONN_4
    SYS_RESOLVE --> CONN_4
    TEACHER_OVERRIDE --> CONN_4
    TEACHER_MARK_EXCUSED --> CONN_4
    CONFIRM_ABSENT --> CONN_4

    CONN_4 --> PERSIST_VERIF["Persist in attendance_verifications Table"]
    PERSIST_VERIF --> CREATE_AUDIT_HIST["Persist in attendance_verification_histories with Audit Trail"]
    CREATE_AUDIT_HIST --> DISPATCH_NOTIFICATION["Dispatch In-App Notification to Teacher Dashboard"]
    DISPATCH_NOTIFICATION --> DOWNSTREAM_SYNC["Downstream Sync: SF-2 Monthly Attendance Register and Early Warning At-Risk Engine"]
    DOWNSTREAM_SYNC --> TERM_SUCCESS(["Terminal: Attendance Cycle Finalized"])
