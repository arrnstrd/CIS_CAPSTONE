Table users {
  id bigint [pk]
  employee_id varchar [unique, null]
  first_name varchar
  last_name varchar
  role enum
  status enum
  email varchar [unique]
  email_verified_at timestamp [null]
  password varchar
  remember_token varchar [null]
  deleted_at timestamp [null]
  created_at timestamp
  updated_at timestamp
}

Table teachers {
  id bigint [pk]
  user_id bigint [ref: > users.id, unique]
  status enum
  created_at timestamp
  updated_at timestamp
}

Table guardians {
  id bigint [pk]
  student_id bigint [ref: > students.id]
  name varchar
  relationship enum
  email varchar
  created_at timestamp
  updated_at timestamp
}

Table students {
  id bigint [pk]
  student_number varchar [unique, null]
  lrn varchar [unique]
  first_name varchar
  middle_name varchar [null]
  last_name varchar
  sex enum
  birthdate date
  address varchar
  status enum
  created_at timestamp
  updated_at timestamp
}

Table school_years {
  id bigint [pk]
  school_year varchar
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table sections {
  id bigint [pk]
  name varchar
  level enum
  grade_level int
  advisor_id bigint [ref: > teachers.id, null]
  capacity int
  status enum
  created_at timestamp
  updated_at timestamp
}

Table subjects {
  id bigint [pk]
  code varchar
  name varchar
  level enum
  created_at timestamp
  updated_at timestamp
}

Table enrollments {
  id bigint [pk]
  student_id bigint [ref: > students.id]
  section_id bigint [ref: > sections.id]
  school_year_id bigint [ref: > school_years.id]
  level enum
  session_type enum
  status enum
  created_at timestamp
  updated_at timestamp
}

Table teaching_assignments {
  id bigint [pk]
  teacher_id bigint [ref: > teachers.id]
  subject_id bigint [ref: > subjects.id]
  section_id bigint [ref: > sections.id]
  school_year_id bigint [ref: > school_years.id]

  session_type enum
  in_start time
  late_threshold time
  out_end time

  status enum

  created_at timestamp
  updated_at timestamp
}

Table qr_codes {
  id bigint [pk]
  student_id bigint [ref: > students.id]
  code varchar
  image_path varchar
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table attendance_logs {
  id bigint [pk]
  enrollment_id bigint [ref: > enrollments.id]
  scan_type enum
  session_type enum
  scan_time datetime
  scanned_by_user_id bigint [ref: > users.id, null]
  device_id varchar [null]
  created_at timestamp
  updated_at timestamp
}

Table room_attendance {
  id bigint [pk]
  teaching_assignment_id bigint [ref: > teaching_assignments.id]
  enrollment_id bigint [ref: > enrollments.id]
  attendance_date date
  time_in datetime
  time_out datetime [null]
  remarks varchar
  created_at timestamp
}

Table flagged_scans {
  id bigint [pk]
  attendance_log_id bigint [ref: > attendance_logs.id, null]
  flag_type enum
  description text [null]
  created_at timestamp
  updated_at timestamp
}

Table email_logs {
  id bigint [pk]
  attendance_log_id bigint [ref: > attendance_logs.id, null]
  student_id bigint [ref: > students.id]
  email varchar
  scan_type enum
  status enum
  attempt_count int
  last_attempt_at datetime
  sent_at datetime
  created_at timestamp
  updated_at timestamp
}

//////////////////////////////////////////////////
// LOOKUP TABLES
//////////////////////////////////////////////////

Table grading_periods {
  id bigint [pk]
  name varchar
  sequence tinyint
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table assessment_categories {
  id bigint [pk]
  name varchar
  created_at timestamp
  updated_at timestamp
}

//////////////////////////////////////////////////
// GRADING
//////////////////////////////////////////////////

Table assessments {
  id bigint [pk]

  teaching_assignment_id bigint [ref: > teaching_assignments.id]

  assessment_category_id bigint [ref: > assessment_categories.id]

  grading_period_id bigint [ref: > grading_periods.id]

  title varchar

  total_items int

  assessment_date date

  status enum

  created_at timestamp
  updated_at timestamp
}

Table student_assessment_scores {
  id bigint [pk]

  assessment_id bigint [ref: > assessments.id]

  enrollment_id bigint [ref: > enrollments.id]

  score decimal

  remarks varchar

  created_at timestamp
  updated_at timestamp
}

Table quarterly_grades {
  id bigint [pk]

  teaching_assignment_id bigint [ref: > teaching_assignments.id]

  enrollment_id bigint [ref: > enrollments.id]

  grading_period_id bigint [ref: > grading_periods.id]

  written_work_grade decimal

  performance_task_grade decimal

  quarterly_assessment_grade decimal

  initial_grade decimal

  transmuted_grade decimal

  created_at timestamp
  updated_at timestamp
}
